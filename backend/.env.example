# SQL Server
DB_USER=sa
DB_PASSWORD=your_password
DB_SERVER=localhost
DB_DATABASE=studentskaPraksa

# JWT
JWT_SECRET=change_this_to_a_long_random_string

# Server
PORT=5000

# E-mail (Gmail SMTP primjer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM=your.email@gmail.com

# Test mod: svi mailovi idu na ovu adresu (opcionalno)
# FORCE_EMAIL_TO=test@example.com

# Alternativa: Gmail OAuth2 (umjesto SMTP)
# GMAIL_USER=
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
